# Copy to .env and never commit .env (Week 2 OIDC + Weeks 5–6)
OKTA_ORG_URL=https://YOUR-ORG.okta.com
OKTA_CLIENT_ID=
OKTA_REDIRECT_URI=http://localhost:8080/login/callback
OKTA_ISSUER=https://YOUR-ORG.okta.com/oauth2/default
# Prefer a custom authorization server issuer after Week 5 Lab 2, for example:
# OKTA_ISSUER=https://YOUR-ORG.okta.com/oauth2/ausXXXXXXXXXXXX
OKTA_AUDIENCE=api://inventory

# Terraform / Management API — use env vars, not files in git
# OKTA_ORG_NAME=YOUR-ORG
# OKTA_BASE_URL=okta.com
# OKTA_API_TOKEN=
